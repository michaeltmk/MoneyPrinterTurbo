    {
      "parameters": {
        "jsCode": "const fontColor = \"white\";\nconst fontFile = \"./fonts/HanyiSentyPagoda Regular.ttf\";\nconst fontSize = 60;\nconst lineHeightMultiplier = 1.1;\nconst videoWidth = 1080;\n\n// For Chinese, each character is generally square, so we use a factor of 1.0\nconst avgCharWidth = fontSize * 1.0;\n// reductionFactor to control maximum characters per line (adjust as needed)\nconst reductionFactor = 0.8;\nconst maxCharsPerLine = Math.floor((videoWidth / avgCharWidth) * reductionFactor);\n\n// Get the full transcript as a string (without splitting by spaces)\nconst text = $('Video Transcript').first().json['Content'];\nconst lines = [];\nlet currentLine = '';\n\n// Process each character individually\nfor (let i = 0; i < text.length; i++) {\n  currentLine += text[i];\n  if (currentLine.length >= maxCharsPerLine) {\n    lines.push(currentLine);\n    currentLine = '';\n  }\n}\nif (currentLine) lines.push(currentLine);\n\nconst totalHeight = lines.length * fontSize * lineHeightMultiplier;\nconst lineHeight = fontSize * lineHeightMultiplier;\n\nconst drawText = lines.map((line, index) => {\n  const y = `(h/2)-${Math.ceil(totalHeight / 2)}+${index * lineHeight}`;\n  return `drawtext=text='${line}':fontsize=${fontSize}:fontcolor=${fontColor}:x=(w-tw)/2:y=${y}:fontfile=${fontFile}`;\n}).join(',');\n\nreturn {\n  json: {\n    drawText\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        840
      ],
      "id": "b539a734-7331-4d2f-9669-f7979ceb90b8",
      "name": "Draw Text"
