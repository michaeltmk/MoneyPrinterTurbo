        "command": "=ffmpeg -ss {{ Math.floor(Math.random() * Math.floor($json.stdout / 10)) *10 }} -i \"{{ $('Random Pick Video').item.json['Internal Path'] }}\" \\-filter_complex \"[0:v]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920[vid];\ncolor=black@0.3:size=1080x1920:d=10[bg];[vid][bg]overlay[bgvid];[bgvid]{{ $('Draw Text').item.json.drawText }}[outv];\n[0:a]volume=1.2[aout]\" \\\n    -map \"[outv]\" \\\n    -map \"[aout]\" \\\n    -t 10 -aspect 9:16 -c:v libx264 -c:a aac -shortest \\\n\"./final.mp4\" -y\n\n\n"
